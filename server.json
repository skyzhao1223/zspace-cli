{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.skyzhao1223/zspace-cli",
  "title": "zspace-cli",
  "description": "Zero-config MCP server + CLI for ZSpace NAS: manage files and pool stats via desktop client proxy.",
  "version": "0.1.4",
