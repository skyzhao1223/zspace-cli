    "url": "https://github.com/skyzhao1223/zspace-cli",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "zspace-cli",
      "version": "0.1.4",
      "transport": {
        "type": "stdio",
        "command": "zs-mcp"
      }
    }
  ],
  "runtime": {
    "type": "python",
    "version": "3.12"
  }
}